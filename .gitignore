# 构建产物（Windows / Linux / ASan 等并行目录）统一收在 builds/ 下
/builds/
# 根目录的 build/ 与 build-*/ 只是旧写法留下的退路，一并挡掉
/build/
/build-*/

# 发布包（由 tools/make_release.ps1 生成）—— **入库**，见 dist/ 目录
# 但包里的样例构建中间产物不是产物（obj/ 之类），挡掉
/dist/**/obj/
/dist/**/__pycache__/

# 文档转换/预览的中间产物
*.pdf
__pycache__/
*.pyc

# 运行期目录：库以当前目录为安装根时会在根下建这些目录
/conf/
/bin/
/log/
/temp/
/uploadFile/
/V*/

# 编译器/编辑器
*.obj
*.o
*.exe
*.pdb
*.ilk
*.log
*.user
.vs/
.vscode/
.idea/

# 文档生成的临时预览
/build/manual-preview.html

# 示例客户端（ncl_client_demo）默认 SN 是 HNC_VDEV_00000，它会在当前目录下建同名目录
/HNC_VDEV_*/
# 设备端 SN 是 "V2" + 9 位十六进制，上面的 /V*/ 已经覆盖它建的运行期目录

# 示例与绑定（examples/{client,device,sdk}）的构建产物与运行期目录：
# 原生垫片 / Java 的构建输出、C# 的 bin/obj、Go 绑定的静态库与运行期文件、
# 自检与示例在自己目录下建的 log/conf/uploadFile/V<sn>/temp。
/examples/**/bin/
/examples/**/bin-tls/
/examples/**/obj/
/examples/**/build/
/examples/**/lib/
/examples/**/log/
/examples/**/conf/
/examples/**/temp/
/examples/**/uploadFile/
/examples/**/V*/
*.dll
*.exp
*.so

# scratch output of tools/site-probe (it copies the site package under run/ and
# builds its probes in place)
tools/site-probe/run/
tools/site-probe/drive
tools/site-probe/probe
tools/site-probe/*.log
tools/site-probe/routes.txt
tools/site-probe/reply.txt
/*-capture.log

# 审计测试写在自己目录下的日志（adapters/tests/test_audit.c）
/ncl_audit_log_test/

# Windows 组件会按字面量写这个路径（相对 cwd），不是仓库产物
%SystemDrive%/
# tap 抓包日志（这一轮的证据，留在本地）
tools/site-probe/tap_fw.log
# focas_capture.py 抓下来的帧（同样是本地证据）
tools/site-probe/cap_*.txt

# internal notes archive (notes / reverse-engineering artifacts, not shipped)
.internal-notes.zip

# dist/ 里的二进制是发布物本体，*.dll / *.exe / *.so 的全局规则会挡住它们
!dist/**/*.dll
!dist/**/*.exe
!dist/**/*.so

# 构建/验证留档压缩包（本地证据，不入库）
logs-archive-*.zip
