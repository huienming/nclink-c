# 构建产物（Windows / Linux / ASan 三套并行目录）
/build/
/build-*/

# 发布包（由 tools/make_release.ps1 生成，不入库）
/dist/

# 文档转换/预览的中间产物
*.pdf
__pycache__/
*.pyc

# 运行期目录：库以当前目录为安装根时会在根下建这些目录
/conf/
/bin/
/log/
/temp/
/uploadFile/
/V*/

# 编译器/编辑器
*.obj
*.o
*.exe
*.pdb
*.ilk
*.log
*.user
.vs/
.vscode/
.idea/

# 文档生成的临时预览
/build/manual-preview.html

# Go 绑定链接的静态库（由 tools/stage-go-libs.sh 暂存，不入库）
/bindings/go/lib/
# 示例客户端（ncl_client_demo）默认 SN 是 HNC_VDEV_00000，它会在当前目录下建同名目录
/HNC_VDEV_*/
# 设备端 SN 是 "V2" + 9 位十六进制，上面的 /V*/ 已经覆盖它建的运行期目录

# C# 绑定的构建产物（源码在 bindings/csharp，产物不入库）
/bindings/csharp/**/bin/
/bindings/csharp/**/obj/
# 共用原生垫片 / Java 绑定的构建产物
/bindings/native/bin/
/bindings/native/bin-tls/
/bindings/java/build/
/bindings/java/native/bin/
/bindings/java/native/bin-tls/
*.dll
*.exp
*.so

# Bindings: runtime logs/samples the self-tests and demos create next to the code
/bindings/*/log/

# Bindings: runtime dirs the self-tests and demos create under their own folder
/bindings/**/V*/
/bindings/**/uploadFile/
/bindings/**/temp/
/bindings/**/conf/
/bindings/**/log/
# Go 绑定：库在 <root>/bin/ 下落的运行期文件（sn.txt 等）
/bindings/go/bin/
# scratch output of tools/site-probe (it copies the site package under run/ and
# builds its probes in place)
tools/site-probe/run/
tools/site-probe/drive
tools/site-probe/probe
tools/site-probe/*.log
tools/site-probe/routes.txt
/*-capture.log
