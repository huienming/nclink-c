# 构建产物（Windows / Linux / ASan 三套并行目录）
/build/
/build-*/

# 发布包（由 tools/make_release.ps1 生成，不入库）
/dist/

# 文档转换/预览的中间产物
*.pdf
__pycache__/
*.pyc

# 运行期目录：库以当前目录为安装根时会在根下建这些目录
/conf/
/bin/
/log/
/temp/
/uploadFile/
/V*/

# 编译器/编辑器
*.obj
*.o
*.exe
*.pdb
*.ilk
*.log
*.user
.vs/
.vscode/
.idea/

# 文档生成的临时预览
/build/manual-preview.html

# Go 绑定链接的静态库（由 tools/stage-go-libs.sh 暂存，不入库）
/bindings/go/lib/
