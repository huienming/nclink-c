<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 一个工程两个目标：.NET Framework 4.7.2 与 .NET 8 -->
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <AssemblyName>Nclink.Demo.Cli</AssemblyName>
    <RootNamespace>Nclink.Demo</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\csharp\src\Nclink.Core\Nclink.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\sdk\native\bin\nclink_shim.dll" Link="nclink_shim.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\sdk\native\bin\nclink_shim.dll')" />
    <None Include="..\..\sdk\native\bin\libnclink_shim.so" Link="libnclink_shim.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\sdk\native\bin\libnclink_shim.so')" />
  </ItemGroup>

</Project>
